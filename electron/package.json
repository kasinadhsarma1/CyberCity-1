{
  "name": "cybercity-electron",
  "version": "1.0.0",
  "description": "Electron shell for Cybercity Next.js app",
  "author": "kasinadhsarma <kasinadhsarma@gmail.com>",
  "homepage": "https://github.com/kasinadhsarma/cybercity",
  "main": "dist/main.js",
  "scripts": {
    "start": "electron .",
    "build": "tsc",
    "watch": "tsc -w",
    "pack": "electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^38.1.2",
    "@types/electron": "^1.4.38",
    "electron-builder": "^26.0.12",
    "typescript": "^5.0.0",
    "@types/node": "^20.8.0"
  },
  "build": {
    "appId": "com.cybercity.app",
    "productName": "Cyber City",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "../out/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "kasinadhsarma <kasinadhsarma@gmail.com>"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    }
  }
}
